# Independent HTTPS origin only. Docker is not required; Databricks Apps are
# forbidden because a custom provider cannot refresh Apps OAuth.
VOICEGUARD_HOSTING_TARGET=independent-https
VOICEGUARD_PROVIDER_AUTH=rotatable-api-key

# Read the same committed deployment configuration used by the current app.
# This supplies the Qwen STT endpoint, Qwen AI Gateway evaluator service and
# destination, and Lakebase project/database/schema. Environment overrides exist
# only for independent release promotion.
VOICEGUARD_APP_CONFIG=/etc/voiceguard/config.yaml

# Authenticated server-side tenant profiles. Callers cannot choose their policy
# bundle or broaden their release-approved languages in request JSON.
VOICEGUARD_TENANTS={"genie-voice":{"api_key_sha256s":["replace-with-64-char-sha256"],"policy_bundle":"strict-v1","languages":["en"]}}

# External VoiceGuard origin authenticates to Databricks with OAuth M2M:
# DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
# DATABRICKS_CLIENT_ID=<service-principal-client-id>
# DATABRICKS_CLIENT_SECRET=<service-principal-secret>
# Derived from realtime_voice.stt_candidates:
# VOICEGUARD_DATABRICKS_STT_ENDPOINT=realtime_voice_stt_qwen3_asr_1_7b

# Only languages that passed the release evaluation may appear here.
VOICEGUARD_SUPPORTED_LANGUAGES=en
VOICEGUARD_POLICY_VERSION=unreleased

# Derived from ai_gateway.model_services.qwen. These remain explicit comments so
# operators can see the effective current-app configuration.
# VOICEGUARD_SEMANTIC_MODEL_SERVICE=partner_demo_catalog.genie_voice_contact_center.genie_voice_qwen_guarded
# VOICEGUARD_SEMANTIC_MODEL_VERSION=system.ai.qwen3-next-80b-a3b-instruct
VOICEGUARD_SEMANTIC_ALLOW_THRESHOLD=0.99

# Derived from lakebase in the current app config:
# VOICEGUARD_LAKEBASE_INSTANCE=genie_voice_lakebase
# VOICEGUARD_LAKEBASE_DATABASE=databricks_postgres
# VOICEGUARD_LAKEBASE_PORT=5432
# VOICEGUARD_LAKEBASE_SCHEMA=genie_voice_contact_center

VOICEGUARD_MAX_REQUEST_BYTES=4000000
